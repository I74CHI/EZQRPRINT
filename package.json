{
  "name": "ezqrprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "wrangler pages dev dist",
    "dev:build": "npm run build && wrangler pages dev dist",
    "dev:vite": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:all": "vitest run",
    "preview": "wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply ezqrprint_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ezqrprint_db --remote"
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.49.0"
  }
}
