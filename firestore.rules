rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsShop(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }

    function publicShopMatches(shopId, slug) {
      let publicShopPath = /databases/$(database)/documents/publicShops/$(slug);
      return exists(publicShopPath)
        && publicShopMatchesExisting(shopId, slug, publicShopPath);
    }

    function publicShopMatchesExisting(shopId, slug, publicShopPath) {
      let publicShop = get(publicShopPath).data;
      return publicShop.id == shopId && publicShop.slug == slug;
    }

    function publishedShop(shopId) {
      let shopPath = /databases/$(database)/documents/shops/$(shopId);
      return exists(shopPath) && publishedShopExists(shopId, shopPath);
    }

    function publishedShopExists(shopId, shopPath) {
      let shop = get(shopPath).data;
      return shop.id == shopId && publicShopMatches(shopId, shop.slug);
    }

    function validRates(rates) {
      return rates is map
        && rates.keys().hasOnly(['bwPerPage', 'colorPerPage'])
        && rates.keys().hasAll(['bwPerPage', 'colorPerPage'])
        && rates.bwPerPage is number
        && rates.colorPerPage is number
        && rates.bwPerPage >= 0
        && rates.colorPerPage >= 0;
    }

    function validShop(shop) {
      return shop.keys().hasOnly([
          'id', 'ownerUid', 'shopName', 'slug', 'upiId', 'upiPayeeName',
          'rates', 'dailyCounter', 'lastOrderDate', 'createdAt'
        ])
        && shop.keys().hasAll([
          'id', 'ownerUid', 'shopName', 'slug', 'rates',
          'dailyCounter', 'lastOrderDate', 'createdAt'
        ])
        && shop.id is string
        && shop.ownerUid is string
        && shop.shopName is string
        && shop.slug is string
        && (!('upiId' in shop) || shop.upiId is string)
        && (!('upiPayeeName' in shop) || shop.upiPayeeName is string)
        && validRates(shop.rates)
        && shop.dailyCounter is int
        && shop.dailyCounter >= 0
        && shop.lastOrderDate is string
        && shop.createdAt is timestamp;
    }

    function validPublicShop(shop, slug) {
      return shop.keys().hasOnly([
          'id', 'shopName', 'slug', 'upiId', 'upiPayeeName', 'rates'
        ])
        && shop.keys().hasAll(['id', 'shopName', 'slug', 'rates'])
        && shop.id is string
        && shop.shopName is string
        && shop.slug == slug
        && (!('upiId' in shop) || shop.upiId is string)
        && (!('upiPayeeName' in shop) || shop.upiPayeeName is string)
        && validRates(shop.rates);
    }

    function customerPaymentClaim() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentClaimed'])
        && resource.data.status == 'awaiting_payment'
        && resource.data.filesPurged == false
        && request.resource.data.paymentClaimed == true;
    }

    match /shops/{shopId} {
      allow get: if (signedIn() && shopId == request.auth.uid)
        || ownsShop(shopId)
        || publishedShop(shopId);
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == shopId
        && validShop(request.resource.data);
      allow update: if (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.id == resource.data.id
          && validShop(request.resource.data)
        );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /publicShops/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && validPublicShop(request.resource.data, slug)
        && getAfter(/databases/$(database)/documents/shops/$(request.resource.data.id)).data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.id == request.resource.data.id
        && validPublicShop(request.resource.data, slug)
        && getAfter(/databases/$(database)/documents/shops/$(request.resource.data.id)).data.ownerUid == request.auth.uid;
      allow delete: if ownsShop(resource.data.id);
    }

    match /orders/{orderId} {
      allow get: if resource.data.id == orderId;
      allow list: if ownsShop(resource.data.shopId);
      allow create: if false;
      allow update: if (
          ownsShop(resource.data.shopId)
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.id == resource.data.id
          && request.resource.data.tokenNumber == resource.data.tokenNumber
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.files == resource.data.files
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'finalAmount', 'paymentClaimed', 'filesPurged'])
          && request.resource.data.status in ['pending', 'printing', 'awaiting_payment', 'completed']
          && request.resource.data.finalAmount is number
          && request.resource.data.finalAmount >= 0
          && request.resource.data.paymentClaimed is bool
          && (
            request.resource.data.paymentClaimed == resource.data.paymentClaimed
            || (
              resource.data.paymentClaimed == false
              && request.resource.data.paymentClaimed == true
            )
          )
          && request.resource.data.filesPurged is bool
          && (
            request.resource.data.filesPurged == resource.data.filesPurged
            || (
              resource.data.filesPurged == false
              && request.resource.data.filesPurged == true
            )
          )
        ) || customerPaymentClaim();
      allow delete: if false;
    }
  }
}
